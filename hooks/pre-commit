#!/usr/bin/env bash
set -e

echo ""
echo "🔍  Running pre-commit checks..."
echo ""

#######################################
# CLIENT
#######################################
if [ -d "client" ]; then
  echo "📦  Client"
  cd client

  echo "   → Format check..."
  if ! pnpm format:check > /dev/null 2>&1; then
    echo "   ⚠️  Formatting issues found. Fixing..."
    pnpm format
    echo "   ❌  Files were reformatted. Please stage the changes and commit again."
    exit 1
  fi
  echo "   ✅  Format OK"

  echo "   → Lint..."
  pnpm lint
  echo "   ✅  Lint OK"

  echo "   → Typecheck..."
  pnpm tsc --noEmit
  echo "   ✅  Typecheck OK"

  cd ..
  echo ""
fi

#######################################
# SERVER (descomentalo cuando lo tengas listo)
#######################################
# if [ -d "server" ]; then
#   echo "🖥️   Server"
#   cd server
#   ...
#   cd ..
# fi

echo "🎉  All checks passed!"
echo ""